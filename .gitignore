# =============================================================================
#  Codermuks in Termux — список исключений для Git
# =============================================================================

# --- Секреты и личные данные ------------------------------------------------
# key.txt

# --- Python: кэш интерпретатора и байт-код ---------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Python: виртуальные окружения -----------------------------------------
.venv/
venv/
env/
ENV/
.conda/

# --- Python: артефакты сборки и дистрибутивы -------------------------------
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/
pip-wheel-metadata/

# --- Python: инструменты тестирования и типизации --------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/

# --- Логи и временные файлы -------------------------------------------------
*.log
*.tmp
*.bak
*.swp
*.swo
*~

# --- Codermuks: пользовательские артефакты ---------------------------------
artifacts/
output/
temp/
*.out

# --- Скомпилированные бинарники --------------------------------------------
*.o
*.obj
*.exe
*.dll
*.dylib
*.class
*.jar
*.war

# --- Rust -------------------------------------------------------------------
target/
Cargo.lock

# --- Go ---------------------------------------------------------------------
*.test
*.prof
vendor/

# --- Java -------------------------------------------------------------------
hs_err_pid*
replay_pid*

# --- Редакторы и IDE --------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
.vim/
\#*\#
.\#*

# --- Операционные системы --------------------------------------------------
.DS_Store
.AppleDouble
.LSOverride
._*
Thumbs.db
ehthumbs.db
Desktop.ini
.directory
.Trash-*

# --- Прочее -----------------------------------------------------------------
*.orig
*.rej
local.*
*.local
