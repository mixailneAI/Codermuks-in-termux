#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
#  Codermuks in Termux — лаунчер
# =============================================================================
#  Скрипт вызывается через симлинк из $PREFIX/bin/codermuks.
#  Чтобы найти main.py рядом с собой, разыменовываем симлинк через readlink -f.
# =============================================================================

SELF_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$SELF_PATH")" && pwd)"

if [ ! -f "$SCRIPT_DIR/main.py" ]; then
    echo -e "\033[31m[Ошибка]\033[0m Не найден main.py в директории: $SCRIPT_DIR"
    echo -e "\033[33m[Подсказка]\033[0m Переустанови Codermuks: bash install.sh"
    exit 1
fi

if ! command -v python >/dev/null 2>&1; then
    echo -e "\033[31m[Ошибка]\033[0m Python не установлен."
    echo -e "\033[33m[Подсказка]\033[0m Установи: pkg install python"
    exit 1
fi

exec python "$SCRIPT_DIR/main.py" "$@"
