#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
#  Codermuks in Termux — лаунчер
# =============================================================================
#  Этот скрипт — точка входа для команды `codermuks` в терминале.
#  Он находит директорию, в которой лежит сам, и запускает Python-приложение
#  через main.py, передавая ему все аргументы командной строки.
#
#  Именно этот файл при установке копируется в $PREFIX/bin/codermuks,
#  благодаря чему команда доступна из любой директории Termux.
# =============================================================================

# --- Определяем директорию, в которой находится сам скрипт -----------------
# BASH_SOURCE[0] — путь к текущему файлу, даже если он запущен через симлинк.
# dirname — берём директорию, cd + pwd — получаем абсолютный путь.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# --- Проверяем, что main.py на месте ---------------------------------------
# Если файла нет — значит, установка повреждена или запущен не тот файл.
if [ ! -f "$SCRIPT_DIR/main.py" ]; then
    echo -e "\033[31m[Ошибка]\033[0m Не найден main.py в директории: $SCRIPT_DIR"
    echo -e "\033[33m[Подсказка]\033[0m Переустанови Codermuks: bash install.sh"
    exit 1
fi

# --- Проверяем, что Python доступен ----------------------------------------
# Termux по умолчанию ставит python в $PREFIX/bin/python.
if ! command -v python >/dev/null 2>&1; then
    echo -e "\033[31m[Ошибка]\033[0m Python не установлен."
    echo -e "\033[33m[Подсказка]\033[0m Установи: pkg install python"
    exit 1
fi

# --- Запускаем основное приложение -----------------------------------------
# exec заменяет текущий процесс на Python — так мы не плодим лишние
# процессы и корректно пробрасываем все сигналы (Ctrl+C и т.д.).
# "$@" — передаём все аргументы, с которыми вызвали `codermuks`.
exec python "$SCRIPT_DIR/main.py" "$@"